# ============================================================
# AgentCommerce — mainnet deployment configuration
# Copy to .env (server) — NEXT_PUBLIC_* vars are inlined into the
# frontend at build time and must be set before `next build`.
# Until contract addresses are deployed the UI runs in
# "integration mode": wallet connection works, onchain actions are
# disabled with setup instructions instead of simulated.
# ============================================================

# --- Network (client) ---
# Default chain for the UI: 8453 = Base mainnet, 84532 = Base Sepolia testnet
NEXT_PUBLIC_DEFAULT_CHAIN_ID=8453
NEXT_PUBLIC_BASE_MAINNET_RPC=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org

# --- Stablecoin (client, Circle USDC — do not change on mainnet) ---
NEXT_PUBLIC_USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_USDC_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# --- Deployed contracts (client) — filled by `forge script Deploy` ---
# Empty = not deployed = onchain actions disabled with setup guidance.
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_IDENTITY_ADDRESS=
NEXT_PUBLIC_REPUTATION_ADDRESS=
NEXT_PUBLIC_WALLET_FACTORY_ADDRESS=

# --- Wallet providers (client) ---
# Get one at https://cloud.walletconnect.com — enables QR pairing.
# Injected wallets + Coinbase Wallet work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Marketplace economics (client) ---
NEXT_PUBLIC_PLATFORM_FEE_BPS=400
NEXT_PUBLIC_REFERRAL_BPS=100
NEXT_PUBLIC_BUILDER_CODE=agentcommerce

# --- Backend / operator (server only, never NEXT_PUBLIC_) ---
DATABASE_URL=postgres://user:pass@localhost:5432/agent_commerce
OPERATOR_PRIVATE_KEY=0x...
ESCROW_ADDRESS=
IDENTITY_ADDRESS=
REPUTATION_ADDRESS=
WALLET_FACTORY_ADDRESS=
USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_FACILITATOR_URL=http://localhost:3000/api/x402
PLATFORM_FEE_BPS=400
REFERRAL_BPS=100
CDP_API_KEY=
BUILDER_CODE=agentcommerce
